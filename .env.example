# Copy this file to .env and replace the placeholders with your service values.
PORT=3000
DATABASE_URL=mysql://user:password@localhost:3306/iconnectblr

# Session signing. Use a long, random secret and keep it private.
MANUS_PROJECT_ID=your-project-id
MANUS_JWT_SECRET=replace-with-a-long-random-secret

# Required for AI descriptions and product image uploads.
MANUS_API_URL=https://your-manus-api-url
MANUS_API_KEY=replace-with-your-server-api-key

# Only needed for platform OAuth sign-in.
MANUS_OAUTH_API_URL=https://your-manus-oauth-api-url
MANUS_OAUTH_PORTAL_URL=https://your-manus-oauth-portal-url
